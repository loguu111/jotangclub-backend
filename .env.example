# ============================================================
# 环境变量模板
#
# 用法（三步）：
#   1. 复制一份：  cp .env.example .env
#   2. 打开 .env，把下面的值填上（留空 = 没配置）
#   3. 让它生效：  set -a && source .env && set +a
#      （set -a 的作用是：source 时把里面的变量自动 export）
#
# ⚠️ .env 已经写进 .gitignore，不会被提交。
#    这个文件（.env.example）只放"变量名 + 说明"，绝不放真实值。
# ============================================================

# ---------- MySQL（必填，否则连不上数据库） ----------
# 数据库用户名，一般就是 root
DB_USERNAME=root
# 数据库密码：填你自己的 MySQL 密码
DB_PASSWORD=

# ---------- 大模型（选填） ----------
# 留空也能正常启动：只有 /chat 会返回 502，其他功能全部可用，测试也能全绿。
# 要试 AI 对话时才需要填，key 在 https://platform.deepseek.com/ 的 API keys 页面创建。
# 格式示例：DEEPSEEK_API_KEY=sk-1234567890abcdef
DEEPSEEK_API_KEY=
